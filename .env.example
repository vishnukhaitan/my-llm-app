# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=

# Required for Vocareum / other OpenAI-compatible gateways
# Leave unset to use https://api.openai.com/v1
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# Required only when verifying OpenAI webhook signatures
# OPENAI_WEBHOOK_SECRET=

# =========================
# Application
# =========================
APP_ENV=development
APP_NAME=my-llm-app
LOG_LEVEL=INFO

# =========================
# LLM Configuration
# =========================
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000
USE_FAKE=false

# =========================
# Optional API Server
# =========================
HOST=0.0.0.0
PORT=8000
